# Normalise line endings so the pipeline runs on Linux servers unchanged.
# Shell and Python scripts with CRLF fail in ways that are painful to debug.
* text=auto eol=lf

*.sh  text eol=lf
*.py  text eol=lf
*.R   text eol=lf
*.r   text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.tsv text eol=lf
*.md  text eol=lf
*.cff text eol=lf

# Binary artefacts should never be line-ending converted
*.h5    binary
*.h5ad  binary
*.rds   binary
*.png   binary
*.pdf   binary
